{
  "name": "airline-resolution-agent-server",
  "version": "1.0.0",
  "description": "Backend for an Airline Customer-Facing Resolution Agent (Express + TypeScript + Groq)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-data.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:data": "tsx src/utils/verify-data.ts",
    "verify:services": "tsx src/utils/verify-services.ts",
    "verify:engine": "tsx src/utils/verify-policy-engine.ts"
  },
  "keywords": [
    "airline",
    "agent",
    "express",
    "typescript",
    "groq"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
