# Server
PORT=5000
NODE_ENV=development

# Groq (https://console.groq.com/keys)
# Leave GROQ_API_KEY empty to run in deterministic fallback mode.
GROQ_API_KEY=
# Optional: override the Groq chat model.
GROQ_MODEL=openai/gpt-oss-120b
# Set to 1 to force deterministic fallback replies (no LLM calls).
# Used by the verify:* suites and as an ops kill-switch.
LLM_DISABLED=
# Comma-separated browser origins allowed by CORS (production).
# Example: https://aeroresolve-web.onrender.com
# Leave empty in development (local Vite origins are allowed automatically).
CORS_ORIGIN=
